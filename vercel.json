{
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,**/tensorflow/include/**,**/tensorflow/compiler/**,**/tensorboard/**,**/*.h,**/*.inc,**/*.a}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
